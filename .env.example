# Every environment variable cjp reads (cjp/config.py; Plan P2.10).
# Copy to .env in the repo root and fill in the first block; the rest are
# optional and show their defaults. .env is gitignored: it holds secrets and
# what belongs to this machine. What belongs to the method (models, request
# parameters, prices, scoring) is in config/settings.yaml, which is tracked.
# Check the result with: cjp doctor

# ── Required ────────────────────────────────────────────────────────────────
# Claude API key. `cjp doctor` checks it through the Models API (no tokens).
ANTHROPIC_API_KEY=sk-ant-...
# Wazuh manager API (authentication, agent config), reached through the SSH
# tunnel: ssh -N -L 9200:localhost:9200 -L 55000:localhost:55000 jesse@<vm-ip>
WAZUH_URL=https://127.0.0.1:55000
WAZUH_USER=wazuh
WAZUH_PASS=...
# Wazuh indexer (OpenSearch; alert retrieval), same tunnel.
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=admin
INDEXER_PASS=...
# The UTM VM, for key-based non-interactive SSH: offline collection, clock
# offset, `cjp vm deploy`, `cjp session new`, `cjp doctor`.
VM_HOST=<vm-ip-or-hostname>

# ── Optional: the VM ────────────────────────────────────────────────────────
# SSH user on the VM. VM_ROOT and every path below default from it.
# VM_USER=jesse
# Where `cjp vm deploy` puts the repo's vm/ (absolute).
# VM_ROOT=/home/jesse/cjp-vm
# VM_DATA_DIR=/home/jesse/cjp-vm/juice-shop/data
# VM_SESSIONS_DIR=/home/jesse/cjp-vm/juice-shop/data/sessions
# Recorded in session manifests; the script the VM runs is the deployed one.
# VM_ATTACKS_SH_PATH=/home/jesse/cjp-vm/juice-shop/attacks.sh
# The indexer `location` wildcard of each SIEM evidence arm. They must stay
# disjoint, and must match the agent's <localfile> paths
# (vm/wazuh/agent_localfile.xml), or that arm's alerts are silently dropped.
# JUICE_LOG_PATH=/home/jesse/cjp-vm/juice-shop/data/logs/access.log*                        # S1-plain
# ENRICHED_JUICE_LOG_PATH=/home/jesse/cjp-vm/juice-shop/data/logs/enriched_access.log*      # S2-body-in-url
# BODY_FIELD_JUICE_LOG_PATH=/home/jesse/cjp-vm/juice-shop/data/logs/body_field_access.log*  # S3-body-field
# The Wazuh agent on the VM host that tails those logs.
# WAZUH_AGENT_ID=001
# Recorded in session manifests (descriptive only; not checked).
# WAZUH_VERSION=4.14.4
# JUICE_SHOP_IMAGE=bkimminich/juice-shop (unpinned)

# ── Optional: this machine ──────────────────────────────────────────────────
# Research data: sessions, corpus, runs, cache, ratings, triage jobs (gitignored).
# CJP_DATA_DIR=<repo>/data
# Tracked results (canonical.yaml, tables, figures). Tests point it elsewhere.
# CJP_RESULTS_DIR=<repo>/results
# Triage model for this shell: an alias or ID from config/settings.yaml
# `models` (default: its triage.model). Runs record the model either way.
# CJP_TRIAGE_MODEL=sonnet
# 1 = show the Python traceback as well as cjp's one-line error and fix.
# CJP_DEBUG=0
